# Core API settings for the frontend. Copy to .env.local and change as needed.

# Where the browser sends API calls. The default /api is proxied by Vite (npm run dev / preview) to the backend.
# For a build served without the proxy, set the full backend URL, e.g. https://api.example.com
VITE_API_BASE_URL=/api

# Tenant sent in X-Tenant-Id on every call (development tenant: acme)
VITE_TENANT_ID=acme

# Backend the Vite dev/preview proxy forwards /api to (read by vite.config.ts, not by the app)
VITE_API_PROXY_TARGET=http://127.0.0.1:3200

# Sample OTP shown on the password reset screen until email is set up (owner decision D10). A development build shows
# 123456 when this is unset. Set it to match the backend's SAMPLE_OTP_CODE on a test build; never set it in production.
# VITE_SAMPLE_OTP_CODE=123456
