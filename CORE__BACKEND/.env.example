NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://user:password@localhost:5432/velox_core
# JWT_SECRET=<at least 32 random characters; required when NODE_ENV=production>
# Browser origins allowed to call the API, comma-separated, no trailing slash. Unset means no CORS headers.
# CORS_ORIGINS=http://localhost:5173
# Passkeys (WebAuthn). RP ID is the bare domain; origins are comma-separated full URLs.
# Outside production they default to localhost and http://localhost:PORT; production requires both.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGINS=http://localhost:3000
# Active sessions per user. Default 1: a new sign-in signs out the user's other session.
# SESSION_DEVICE_LIMIT=1
# Password reset code used until an email provider is chosen (owner decision D10). No email is sent. Development
# uses 123456 when unset; set it to six digits on a test server. Must not be set in production (startup refuses it).
# SAMPLE_OTP_CODE=123456
# Approval reminder sweep, in minutes (requests are reminded, never escalated). 0 turns it off, for example when a
# scheduler runs `npm run approvals:remind` instead.
# APPROVAL_REMINDER_MINUTES=15
# Outbox relay retries (open decision D14: there are no defaults; the relay does not start until all four are set
# and a transport is chosen, D13). Example only:
# EVENT_RETRY_MAX_ATTEMPTS=
# EVENT_RETRY_BASE_SECONDS=
# EVENT_RETRY_FACTOR=
# EVENT_RETRY_MAX_DELAY_SECONDS=
